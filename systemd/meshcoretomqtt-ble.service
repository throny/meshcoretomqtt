[Unit]
Description=MeshCore to MQTT Relay (SenseCAP observer over BLE)
After=time-sync.target network-online.target bluetooth.service
Wants=time-sync.target network-online.target

[Service]
Type=exec
User=mctomqtt
Group=mctomqtt
UMask=0077
LimitCORE=0
StandardOutput=journal
StandardError=journal
WorkingDirectory=/opt/mctomqtt
ExecStart=/opt/mctomqtt/venv/bin/python3 /opt/mctomqtt/mctomqtt.py
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
RuntimeDirectory=mctomqtt-ble
RuntimeDirectoryMode=0700
# Startup transport unavailability currently returns success from the runner.
# Explicit supervisor stop still suppresses restarts and uses graceful SIGTERM.
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/mctomqtt

# Deliberately no [Install] section: this template is not enabled by default.
